{
  "name": "creator-insights-temporal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:worker": "ts-node src/worker.ts",
    "dev:worker": "nodemon src/worker.ts",
    "start:workflows": "ts-node src/scripts/start-workflows.ts",
    "start:naive": "ts-node src/scripts/start-naive.ts",
    "start:validation": "ts-node src/scripts/start-validation.ts",
    "query:progress": "ts-node src/scripts/query-progress.ts",
    "corrupt:data": "ts-node src/scripts/corrupt-data.ts",
    "db:migrate": "ts-node src/db/migrate.ts",
    "test": "mocha --exit --require ts-node/register --require source-map-support/register 'src/**/*.test.ts'"
  },
  "nodemonConfig": {
    "execMap": { "ts": "ts-node" },
    "ext": "ts",
    "watch": ["src"]
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.6",
    "@temporalio/client": "^1.11.6",
    "@temporalio/worker": "^1.11.6",
    "@temporalio/workflow": "^1.11.6",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.11.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.9.1",
    "@types/pg": "^8.15.4",
    "mocha": "^11.5.0",
    "nodemon": "^3.1.7",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
