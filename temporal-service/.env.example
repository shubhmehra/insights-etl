# Temporal server
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=creator-insights

# App database (app-db service in docker-compose — port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=creator_insights
DB_USER=creator_insights
DB_PASSWORD=creator_insights

# Mock Instagram API
INSTAGRAM_API_BASE_URL=http://localhost:3001

# Set to 'true' to shorten tokenRefresh sleep from 55 days → 15 seconds
DEMO_MODE=true
